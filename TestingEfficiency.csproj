<Project Sdk="Tomat.Terraria.ModLoader.Sdk/2.1.1">

	<!-- Import tModLoader mod properties -->
	<Import Project="..\tModLoader.targets" />

	<!-- General -->
	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<TmlVersion>stable</TmlVersion>
		<TargetFramework>net10.0</TargetFramework>
		<TomatEnableMod>true</TomatEnableMod>
		<PpebNetcoredbg>true</PpebNetcoredbg>
		<Lolxd87Splashskip>true</Lolxd87Splashskip>
		<TomatEnvironmentModlist>true</TomatEnvironmentModlist>
		<TomatAssetHotReloading>true</TomatAssetHotReloading>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>TestingEfficiency</AssemblyName>
		<GenerateAssemblyInfo>False</GenerateAssemblyInfo>
	</PropertyGroup>
	<PropertyGroup>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	</PropertyGroup>

	<!-- References -->
	<ItemGroup>

	</ItemGroup>

</Project>